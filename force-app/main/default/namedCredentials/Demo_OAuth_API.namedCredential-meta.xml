<?xml version="1.0" encoding="UTF-8"?>
<!--
    Named Credential — Demo_OAuth_API (OAuth 2.0 Client Credentials)
    ══════════════════════════════════════════════════════════════════
    Demonstrates an OAuth-authenticated Named Credential where the platform
    automatically manages token fetch, storage, and refresh.

    HOW PLATFORM OAUTH WORKS:
      1. On first callout, the platform POSTs client_credentials to the token endpoint
      2. Access token is stored encrypted in the Named Credential
      3. Platform injects "Authorization: Bearer <token>" into every callout automatically
      4. When the token expires (expires_in), platform auto-refreshes before the next callout
      5. Apex code is completely unaware of tokens — just uses 'callout:Demo_OAuth_API/path'

    WHEN TO USE THIS VS MANUAL TOKEN MANAGEMENT:
      Platform-managed (this):    simple, no custom token logic, 1 connected app
      Manual (JwtTokenService):   multiple token endpoints, custom claims, token caching,
                                  or cross-org token exchange scenarios
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>Demo OAuth API</label>
    <url>https://api.example.com/v2</url>
    <protocol>Oauth</protocol>
    <!-- Auth Provider referenced here handles token endpoint + client_id/secret -->
    <authProvider>Demo_OAuth_Provider</authProvider>
    <oauthScope>api read:accounts</oauthScope>
</NamedCredential>
