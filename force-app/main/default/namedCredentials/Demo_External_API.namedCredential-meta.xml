<?xml version="1.0" encoding="UTF-8"?>
<!--
    Named Credential — Demo_External_API
    ══════════════════════════════════════════════════════════════════════════════
    PURPOSE: Demonstration Named Credential for interview-prep callout patterns.

    NAMED CREDENTIAL MODELS (two exist side-by-side as of API v57):
    ════════════════════════════════════════════════════════════════
    Legacy (this file):
      • protocol + auth fields inline in the NamedCredential itself
      • Simple to set up; supports NoAuthentication, Password, OAuth (org-wide)
      • label + url stored together

    New model (API 57+, recommended):
      • NamedCredential references an ExternalCredential via <externalCredential>
      • ExternalCredential holds the auth protocol and per-principal secrets
      • Supports per-user OAuth, Named Principals, and Anonymous principals
      • Allows multiple principals (user-level vs org-level) on the same endpoint

    USAGE IN APEX:
      req.setEndpoint('callout:Demo_External_API/path/to/resource');
      // Platform injects auth headers automatically based on protocol
      // The URL becomes: https://api.example.com/v1/path/to/resource

    PROTOCOL OPTIONS:
      NoAuthentication  — no auth headers (public APIs or headers set manually)
      Password          — basic auth; username + password stored encrypted
      Oauth             — OAuth 2.0 org-wide; platform refreshes tokens automatically
      Jwt               — JWT Bearer Token; references a certificate
      JwtExchange       — JWT + token exchange; used for Salesforce-to-Salesforce

    MERGE FIELDS IN HEADERS/BODY:
      allowMergeFieldsInHeader = true enables {!$Credential.UserName} etc. in header formulas
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>Demo External API</label>
    <!-- Replace with actual endpoint in target org — Remote Site Settings not needed for NCs -->
    <url>https://api.example.com/v1</url>
    <!-- NoAuthentication: auth handled in Apex (e.g. Bearer token added via setHeader) -->
    <protocol>NoAuthentication</protocol>
</NamedCredential>
