<?xml version="1.0" encoding="UTF-8"?>
<!--
    Account_Score_Calculator — Auto-Launched Flow (Invocable)

    PURPOSE
    ═══════
    Demonstrates an Auto-Launched Flow that orchestrates multiple steps:
      1. Calls Invocable Apex (FlowActionCalculateScore) to compute a score
      2. Checks the returned tier via a Decision node
      3. Updates the Account record with the score and a tier badge
      4. Sends a Platform Event (or Email Alert in simpler orgs)

    AUTO-LAUNCHED FLOW vs RECORD-TRIGGERED FLOW
    ════════════════════════════════════════════
    Auto-Launched Flow:
      • No trigger — must be explicitly invoked
      • Invoked by: Apex (Flow.Interview), another Flow (Subflow), REST API,
        Process Builder (legacy), or scheduled (Scheduled Flow)
      • Accepts input variables — caller passes context data
      • Returns output variables — caller can read results
      • processType = AutoLaunchedFlow

    Record-Triggered Flow:
      • Fires automatically on record create/update/delete
      • processType = AutoLaunchedFlow + triggerType in <start>
      • NO explicit input variables — uses $Record and $Record__Prior
      • Cannot return outputs to a caller

    INVOCABLE APEX INTEGRATION
    ══════════════════════════
    The "Calculate Account Score" action maps to @InvocableMethod in
    FlowActionCalculateScore.cls. Flow passes accountId as input and
    receives back score (Decimal) and tier (String) as outputs.

    Key rules for @InvocableMethod:
      • Method must be static, public/global
      • Parameter: List<T> where T has @InvocableVariable fields
      • Return: void, List<T>, or List<List<T>> (for bulk)
      • Only one @InvocableMethod per class
      • CANNOT be called from @future, Batch, or another @InvocableMethod
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Auto-launched flow invoked from Apex or another Flow. Calls FlowActionCalculateScore invocable Apex, then updates the Account with the computed score and tier.</description>
    <environments>Default</environments>
    <interviewLabel>Account Score Calculator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Score Calculator</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ═══ INPUT VARIABLES ══════════════════════════════════════════════════ -->
    <!--
        Variables with isInput=true are settable by the caller.
        Variables with isOutput=true are readable by the caller after the flow.
        A variable can be both (bidirectional).
        Interview: what is the difference between a Flow Variable and a Flow Resource?
          Variable = data store (scalar, collection, sObject, sObject collection)
          Resource = variable, formula, constant, text template, stage, choice, etc.
    -->
    <variables>
        <name>accountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>calculatedScore</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <name>calculatedTier</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <!-- Collection variable to hold Apex action results (List output) -->
    <variables>
        <name>apexResults</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FlowActionCalculateScore.Result</objectType>
    </variables>

    <!-- ═══ START ════════════════════════════════════════════════════════════ -->
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <!-- Auto-Launched: no triggerType, no object -->
        <connector>
            <targetReference>Calculate_Score_Action</targetReference>
        </connector>
    </start>

    <!-- ═══ APEX ACTION ═══════════════════════════════════════════════════════ -->
    <!--
        actionType=APEX maps to @InvocableMethod.
        actionName = fully qualified class name.
        inputParameters map Flow variables to @InvocableVariable fields on Request.
        outputParameters map @InvocableVariable fields on Result to Flow variables.
    -->
    <actionCalls>
        <name>Calculate_Score_Action</name>
        <label>Calculate Account Score</label>
        <locationX>56</locationX>
        <locationY>120</locationY>
        <actionName>FlowActionCalculateScore</actionName>
        <actionType>APEX</actionType>
        <faultConnector>
            <targetReference>Handle_Apex_Fault</targetReference>
        </faultConnector>
        <connector>
            <targetReference>Check_Score_Tier</targetReference>
        </connector>
        <inputParameters>
            <name>accountId</name>
            <value><elementReference>accountId</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>calculatedScore</assignToReference>
            <name>score</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>calculatedTier</assignToReference>
            <name>tier</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>

    <!-- ═══ DECISION: route by tier ══════════════════════════════════════════ -->
    <decisions>
        <name>Check_Score_Tier</name>
        <label>Check Score Tier</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Bronze or Unknown</defaultConnectorLabel>
        <rules>
            <name>Is_Platinum</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>calculatedTier</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Platinum</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Score</targetReference>
            </connector>
            <label>Platinum</label>
        </rules>
        <rules>
            <name>Is_Gold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>calculatedTier</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Gold</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Score</targetReference>
            </connector>
            <label>Gold</label>
        </rules>
    </decisions>

    <!-- ═══ RECORD UPDATE ═════════════════════════════════════════════════════ -->
    <recordUpdates>
        <name>Update_Account_Score</name>
        <label>Update Account Score and Tier</label>
        <locationX>56</locationX>
        <locationY>360</locationY>
        <faultConnector>
            <targetReference>Handle_Apex_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>accountId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Account_Score__c</field>
            <value><elementReference>calculatedScore</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Tier__c</field>
            <value><elementReference>calculatedTier</elementReference></value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>

    <!-- ═══ FAULT HANDLER ════════════════════════════════════════════════════ -->
    <recordCreates>
        <name>Handle_Apex_Fault</name>
        <label>Log Apex Fault</label>
        <locationX>296</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value><stringValue>FLOW ERROR: Account Score Calculator failed</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value><stringValue>High</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value><elementReference>$User.Id</elementReference></value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>

</Flow>
