<?xml version="1.0" encoding="UTF-8"?>
<!--
    Validate_Account_Data — Auto-Launched Subflow

    PURPOSE
    ═══════
    Reusable validation subflow called by Account_Onboarding_Wizard.
    Checks whether an Account with the given name already exists.
    Returns isDuplicate (Boolean) and existingAccountId (Id) to the caller.

    SUBFLOW DESIGN PRINCIPLES (interview concepts)
    ══════════════════════════════════════════════
    1. SINGLE RESPONSIBILITY — this flow does one thing: duplicate check.
       Callers handle the user-facing error display.
    2. INPUT/OUTPUT CONTRACT — all data exchange via variables marked
       isInput=true and isOutput=true. Subflows are black boxes to callers.
    3. REUSABLE — any flow that needs to check for duplicate accounts can
       call this subflow instead of duplicating the Get Records + Decision logic.
    4. FAULT PATH — Get Records can fail with sharing/permission errors;
       fault path sets a safe default (isDuplicate = false) rather than
       crashing the parent flow.

    GET RECORDS ELEMENT
    ═══════════════════
    Equivalent to:  SELECT Id FROM Account WHERE Name = :accountName LIMIT 1
    filterLogic: and — all filters must match (only one filter here)
    getFirstRecordOnly: true — stops after finding 1 match (efficient)
    outputReference: stores the found record in foundAccount variable
    If NO record matches: foundAccount = null (platform sets sObject var to null)
    If RECORD found:     foundAccount.Id is populated

    ASSIGNMENT: set isDuplicate
    ═══════════════════════════
    If foundAccount is NOT NULL → isDuplicate = true, copy Id
    The Decision element checks IsNull on foundAccount to branch.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Subflow: checks whether an Account with the given name already exists. Returns isDuplicate (Boolean) and existingAccountId (Id). Called by Account_Onboarding_Wizard.</description>
    <environments>Default</environments>
    <interviewLabel>Validate Account Data {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Validate Account Data</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ═══ INPUT VARIABLES ══════════════════════════════════════════════════ -->
    <variables>
        <name>accountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- ═══ OUTPUT VARIABLES ═════════════════════════════════════════════════ -->
    <variables>
        <name>isDuplicate</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>

    <variables>
        <name>existingAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <!-- ═══ LOCAL VARIABLES ═══════════════════════════════════════════════════ -->
    <variables>
        <name>foundAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <!-- ═══ START ════════════════════════════════════════════════════════════ -->
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Account</targetReference>
        </connector>
    </start>

    <!-- ═══ GET RECORDS ═══════════════════════════════════════════════════════ -->
    <!--
        Get Records: equivalent to SELECT Id, Name FROM Account WHERE Name = :accountName LIMIT 1
        getFirstRecordOnly=true — stops after first match, more efficient than collecting all.
        If no record found: foundAccount remains null (platform behaviour).
        Fault connector: permissions/sharing error → safe default (no duplicate found).
    -->
    <recordLookups>
        <name>Get_Existing_Account</name>
        <label>Get Existing Account by Name</label>
        <locationX>56</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Duplicate_Decision</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Safe_Default</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value><elementReference>accountName</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>foundAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <!-- ═══ DECISION: was a record found? ════════════════════════════════════ -->
    <decisions>
        <name>Is_Duplicate_Decision</name>
        <label>Is Duplicate?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <!-- No record found — not a duplicate; outputs remain at default false/null -->
        </defaultConnector>
        <defaultConnectorLabel>Not a Duplicate</defaultConnectorLabel>
        <rules>
            <name>Is_Duplicate_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <!-- IsNull(foundAccount) = false means a record WAS found -->
                <leftValueReference>foundAccount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Duplicate_True</targetReference>
            </connector>
            <label>Record Found (Duplicate)</label>
        </rules>
    </decisions>

    <!-- ═══ ASSIGNMENTS ═══════════════════════════════════════════════════════ -->
    <assignments>
        <name>Set_Duplicate_True</name>
        <label>Set isDuplicate = true</label>
        <locationX>56</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>isDuplicate</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>existingAccountId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>foundAccount.Id</elementReference></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Safe_Default</name>
        <label>Set Safe Default (fault path)</label>
        <locationX>296</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>isDuplicate</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>false</booleanValue></value>
        </assignmentItems>
    </assignments>

</Flow>
