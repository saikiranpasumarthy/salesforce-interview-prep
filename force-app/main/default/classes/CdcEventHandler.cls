/**
 * CdcEventHandler
 * ══════════════════════════════════════════════════════════════════════════════
 * Day 18 — Change Data Capture: processing AccountChangeEvent in an Apex trigger.
 *
 * WHAT IS CDC?
 * ════════════
 * Change Data Capture (CDC) automatically publishes change events for Salesforce
 * records whenever they are created, updated, deleted, or undeleted.
 * Unlike Platform Events (manual publish), CDC events are generated automatically
 * by the platform whenever a qualifying DML operation occurs.
 *
 * ENABLING CDC:
 * ══════════════
 * Setup → Integrations → Change Data Capture → select objects to enable
 * OR via metadata: include the object in <changedObjects> in a ChangeDataCapture
 * configuration. Once enabled, AccountChangeEvent is available for triggers.
 *
 * CDC EVENT HEADER FIELDS (EventBus.ChangeEventHeader):
 * ══════════════════════════════════════════════════════
 * changeType       — CREATE | UPDATE | DELETE | UNDELETE (String)
 * changedFields    — List<String> of changed field API names (UPDATE only)
 *                    May include '_EventType' or '_SystemModstamp' — see Gap Events below
 * recordIds        — List<String> IDs of changed records (bulk ops have multiple)
 * entityName       — 'Account' (sObject API name)
 * transactionKey   — Unique key for the originating transaction (dedup key)
 * commitTimestamp  — Epoch ms of the originating transaction commit
 * commitNumber     — Sequence number within the commit
 * commitUser       — ID of the user who made the change
 * nulledFields     — List<String> fields set to null (subset of changedFields)
 *
 * GAP EVENTS:
 * ════════════
 * If the subscriber falls behind, the event bus sends a "gap" event where
 * changedFields contains '_SystemModstamp'. This signals the subscriber should
 * re-query the records for full current state rather than relying on the event payload.
 * Also applies when a field change exceeds the max payload size.
 *
 * CDC vs PLATFORM EVENTS:
 * ════════════════════════
 * CDC                              Platform Events
 * ───────────────────────────────  ─────────────────────────────────
 * Auto-generated by DML            Manually published via EventBus.publish()
 * Contains changed field values    Carries arbitrary custom payload
 * Includes change header metadata  No built-in header metadata
 * Only for Salesforce objects       For any business event
 * Setup → CDC to enable            Define Custom Platform Event object
 */
public with sharing class CdcEventHandler {

    private static final String CHANGE_CREATE   = 'CREATE';
    private static final String CHANGE_UPDATE   = 'UPDATE';
    private static final String CHANGE_DELETE   = 'DELETE';
    private static final String CHANGE_UNDELETE = 'UNDELETE';
    // Sentinel field name in changedFields that signals a gap event
    private static final String GAP_FIELD       = '_SystemModstamp';

    // ─────────────────────────────────────────────────────────────────────────
    // Main entry point — called from AccountChangeTrigger
    // ─────────────────────────────────────────────────────────────────────────

    public static void handleAccountChanges(List<AccountChangeEvent> events) {
        Set<Id> createIds   = new Set<Id>();
        Set<Id> updateIds   = new Set<Id>();
        Set<Id> deleteIds   = new Set<Id>();
        Set<Id> gapIds      = new Set<Id>();

        for (AccountChangeEvent event : events) {
            EventBus.ChangeEventHeader header = event.ChangeEventHeader;
            Set<Id> recordIds = toIdSet(header.getRecordIds());

            if (isGapEvent(header)) {
                // Gap event: changedFields unreliable — re-query for full state
                gapIds.addAll(recordIds);
                continue;
            }

            switch on header.changeType {
                when 'CREATE'   { createIds.addAll(recordIds); }
                when 'UPDATE'   { routeUpdate(event, header, updateIds); }
                when 'DELETE'   { deleteIds.addAll(recordIds); }
                when 'UNDELETE' { createIds.addAll(recordIds); }  // treat undelete as create
            }
        }

        processCreates(createIds);
        processUpdates(updateIds);
        processDeletions(deleteIds);
        processGaps(gapIds);  // re-query + treat as full update
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Change-type processors
    // ─────────────────────────────────────────────────────────────────────────

    @TestVisible
    static void processCreates(Set<Id> accountIds) {
        if (accountIds.isEmpty()) { return; }
        List<Account> accounts = [
            SELECT Id, Name, Type, AnnualRevenue, OwnerId
            FROM   Account
            WHERE  Id IN :accountIds
            WITH   SECURITY_ENFORCED
        ];
        // Example action: publish an integration event for downstream systems
        List<Integration_Event__e> events = new List<Integration_Event__e>();
        for (Account acc : accounts) {
            events.add(PlatformEventService.accountSyncEvent(acc.Id, CHANGE_CREATE));
        }
        if (!events.isEmpty()) {
            PlatformEventService.publishBulk(events);
        }
    }

    @TestVisible
    static void processUpdates(Set<Id> accountIds) {
        if (accountIds.isEmpty()) { return; }
        List<Integration_Event__e> events = new List<Integration_Event__e>();
        for (Id id : accountIds) {
            events.add(PlatformEventService.accountSyncEvent(id, CHANGE_UPDATE));
        }
        PlatformEventService.publishBulk(events);
    }

    @TestVisible
    static void processDeletions(Set<Id> accountIds) {
        if (accountIds.isEmpty()) { return; }
        // Deleted records can no longer be queried — use the Ids directly
        List<Integration_Event__e> events = new List<Integration_Event__e>();
        for (Id id : accountIds) {
            events.add(PlatformEventService.accountSyncEvent(id, CHANGE_DELETE));
        }
        PlatformEventService.publishBulk(events);
    }

    @TestVisible
    static void processGaps(Set<Id> accountIds) {
        if (accountIds.isEmpty()) { return; }
        // Re-query for full current state
        List<Account> accounts = [
            SELECT Id, Name, Type, AnnualRevenue, Rating, OwnerId, LastModifiedDate
            FROM   Account
            WHERE  Id IN :accountIds
            WITH   SECURITY_ENFORCED
        ];
        List<Integration_Event__e> events = new List<Integration_Event__e>();
        for (Account acc : accounts) {
            events.add(PlatformEventService.accountSyncEvent(acc.Id, 'GAP_FILL'));
        }
        if (!events.isEmpty()) {
            PlatformEventService.publishBulk(events);
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Field-change routing (UPDATE only)
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Inspects changedFields to route the update to the correct handler.
     * Only adds the record ID to updateIds if it contains a field we care about.
     * This avoids unnecessary downstream work for irrelevant field changes.
     */
    @TestVisible
    static void routeUpdate(
            AccountChangeEvent event,
            EventBus.ChangeEventHeader header,
            Set<Id> updateIds) {

        List<String> changedFields = header.getChangedFields();
        Set<String> fieldsOfInterest = new Set<String>{
            'Name', 'AnnualRevenue', 'Type', 'Rating', 'OwnerId'
        };

        for (String field : changedFields) {
            if (fieldsOfInterest.contains(field)) {
                updateIds.addAll(toIdSet(header.getRecordIds()));
                return;
            }
        }
        // No relevant fields changed — skip processing
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Gap event detection
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Returns true if the event is a gap event.
     * Gap events occur when:
     *  1. The subscriber fell behind (event bus fast-forwards with a gap marker)
     *  2. The payload exceeds the max size (fields truncated)
     * In either case, changedFields is unreliable — re-query for full state.
     */
    @TestVisible
    static Boolean isGapEvent(EventBus.ChangeEventHeader header) {
        if (header.changeType != CHANGE_UPDATE) { return false; }
        List<String> changedFields = header.getChangedFields();
        return changedFields != null && changedFields.contains(GAP_FIELD);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Converts a List<String> of record Id strings to a Set<Id>.
     * CDC header.getRecordIds() returns List<String>, not List<Id>.
     */
    @TestVisible
    static Set<Id> toIdSet(List<String> idStrings) {
        Set<Id> ids = new Set<Id>();
        if (idStrings == null) { return ids; }
        for (String s : idStrings) {
            if (String.isNotBlank(s)) {
                try { ids.add((Id) s); } catch (Exception e) { /* skip malformed */ }
            }
        }
        return ids;
    }
}
